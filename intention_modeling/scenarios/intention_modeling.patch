+int GameEnv::get_last_action(bool left_team, int player) {
+  SetGame(this);
+  int controller_id = player + (left_team ? 0 : 11);
+  if (controller_id < 0 ||
+      controller_id >= static_cast<int>(last_actions_.size()))
+    return static_cast<int>(game_idle);
+  return last_actions_[controller_id];
+}
+
+static Action FunctionTypeToAction(e_FunctionType ft, const Vector3 &dir,
+                                   float velocity) {
+  switch (ft) {
+    case e_FunctionType_Shot:      return game_shot;
+    case e_FunctionType_ShortPass: return game_short_pass;
+    case e_FunctionType_LongPass:  return game_long_pass;
+    case e_FunctionType_HighPass:  return game_high_pass;
+    case e_FunctionType_Sliding:   return game_sliding;
+    default: break;
+  }
+  // Use the controller's desired direction/velocity (not physics movement) so
+  // the result reflects what the AI intended rather than the animation state.
+  if (velocity <= idleVelocity) return game_idle;
+  float vx = dir.coords[0];
+  float vy = dir.coords[1];
+  float mag = sqrtf(vx * vx + vy * vy);
+  if (mag < 0.01f) return game_idle;
+  vx /= mag;
+  vy /= mag;
+  int sx = (vx >  0.5f) ? 1 : (vx < -0.5f ? -1 : 0);
+  int sy = (vy >  0.5f) ? 1 : (vy < -0.5f ? -1 : 0);
+  if (sx == -1 && sy ==  0) return game_left;
+  if (sx == -1 && sy ==  1) return game_top_left;
+  if (sx ==  0 && sy ==  1) return game_top;
+  if (sx ==  1 && sy ==  1) return game_top_right;
+  if (sx ==  1 && sy ==  0) return game_right;
+  if (sx ==  1 && sy == -1) return game_bottom_right;
+  if (sx ==  0 && sy == -1) return game_bottom;
+  if (sx == -1 && sy == -1) return game_bottom_left;
+  return game_idle;
+}
+
+int GameEnv::get_current_function_type(bool left_team, int player) {
+  SetGame(this);
+  auto &players = context->gameTask->GetMatch()
+                      ->GetTeam(left_team ? 0 : 1)->GetAllPlayers();
+  if (player < 0 || player >= static_cast<int>(players.size()))
+    return static_cast<int>(game_idle);
+  PlayerBase *p = players[player];
+  IController *ctrl = p->GetController();
+  return static_cast<int>(
+      FunctionTypeToAction(p->GetCurrentFunctionType(),
+                           ctrl->GetDirection(), ctrl->GetFloatVelocity()));
+}
+
